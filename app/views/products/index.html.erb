<h1>Productos</h1>
<p><%= link_to 'Añadir Producto', new_warehouse_product_path(@warehouse) %></p>
<div class="table-responsive">
  <table class="table table-dark">  
    <tr>
      <th>Nombre</th>
      <th>Precio</th>
      <th>Disponible</th>
      <th>Descripción</th>
      <th></th>
    </tr>
    <% @products.each do |product| %>
    <tr>      
        <td><%= product.name %></td>
        <td><%= product.price%>$</td>
        <td><%= product.stock %></td>
        <td><%= product.description %></td>
        <td><%= link_to "Editar", edit_warehouse_product_path(current_user, product.warehouse, product) %> <%= link_to "Eliminar", warehouse_product_path(current_user, product.warehouse, product), data: {
                    turbo_method: :delete,
                    turbo_confirm: "Are you sure?"
                  } %></td>
    </tr>
    <% end %>
  </table>
</div>
