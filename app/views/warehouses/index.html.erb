<h1>Depositos</h1>
<p> <%= link_to "Crear Depósito", new_warehouse_path %> </p>

<% @warehouses.each do |warehouse| %>
  <p><%= warehouse.name %> <%= link_to "Editar", edit_warehouse_path(warehouse) %> <%= link_to "Eliminar", warehouse_path(warehouse), data: {
                    turbo_method: :delete,
                    turbo_confirm: "Are you sure?"
                  } %> <%= link_to "Productos", warehouse_products_path(warehouse) %> </p>
<% end %>